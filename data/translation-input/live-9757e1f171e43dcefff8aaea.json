    {
      "type": "heading",
      "text": "The Blood Countess"
    },
    {
      "type": "paragraph",
      "text": "Isabelle Huppert dazzles as the Blood Countess in this delightful and high-camp gothic fantasy from visionary filmmaker Ulrike Ottinger."
    },
    {
      "type": "image",
      "url": "https://d3cyv0xf0ss37v.cloudfront.net/2026/films/560x315/nightborn-01.jpeg",
