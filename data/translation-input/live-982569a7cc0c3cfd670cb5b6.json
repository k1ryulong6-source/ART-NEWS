    },
    {
      "type": "heading",
      "text": "VisionQuest"
    },
    {
      "type": "paragraph",
      "text": "Paul Bettany returns as Vision in this highly anticipated follow-up to Marvel’s WandaVision."
    },
    {
      "type": "image",
      "url": "https://d3cyv0xf0ss37v.cloudfront.net/2026/films/560x315/look-back-01.jpeg",
