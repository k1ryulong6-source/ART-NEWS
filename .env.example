# Load this file into your process environment; it contains no credentials.
CULTURE_DESK_PORT=8000
# Optional private service login; username is owner. Use HTTPS when hosting remotely.
# CULTURE_DESK_PASSWORD=
# CULTURE_DESK_DB=/absolute/path/culture-desk.db
SUMMARY_PROVIDER=noop
# Enable for any OpenAI-compatible service:
# SUMMARY_PROVIDER=openai-compatible
# SUMMARY_BASE_URL=https://api.openai.com/v1
# SUMMARY_MODEL=gpt-4.1-mini
# SUMMARY_API_KEY=
SUMMARY_DAILY_LIMIT=20
# Optional email reminders; leave unset to use only the in-app inbox.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=

# Optional public machine translation (no key), separate from AI summaries.
TRANSLATION_PROVIDER=google-public
TRANSLATION_DAILY_LIMIT=1000
READING_PAGE_LIMIT=20

# Refresh publisher embedding checks without removing blocked sources.
ORIGINAL_CHECK_LIMIT=20
