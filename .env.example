# Load this file into your process environment; it contains no credentials.
CULTURE_DESK_PORT=8000
# Optional private service login; username is owner. Use HTTPS when hosting remotely.
# CULTURE_DESK_PASSWORD=
# CULTURE_DESK_DB=/absolute/path/culture-desk.db
SUMMARY_PROVIDER=noop
# Enable for any OpenAI-compatible service:
# SUMMARY_PROVIDER=openai-compatible
# SUMMARY_BASE_URL=https://api.openai.com/v1
# SUMMARY_MODEL=gpt-4.1-mini
# SUMMARY_API_KEY=
SUMMARY_DAILY_LIMIT=20
# Optional email reminders; leave unset to use only the in-app inbox.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=

# Optional public machine translation (no key), separate from AI summaries.
TRANSLATION_PROVIDER=disabled
TRANSLATION_DAILY_LIMIT=1000
READING_PAGE_LIMIT=20

# Collect public article bodies; failed/restricted sources stay in the dataset.
ARTICLE_PAGE_LIMIT=60
# Full-body machine translation calls per day, shared with title/excerpt ledger.
ARTICLE_TRANSLATION_LIMIT=120

# Full-context translation + separate bilingual review. No Google fallback.
EDITORIAL_PROVIDER=chatgpt-task
EDITORIAL_BASE_URL=https://api.openai.com/v1
EDITORIAL_MODEL=gpt-4.1
EDITORIAL_REVIEW_MODEL=gpt-4.1
# Set privately in your environment or GitHub Actions secret, never in source:
# EDITORIAL_API_KEY=
# Each article normally needs two calls (draft + review).
EDITORIAL_DAILY_LIMIT=20
EDITORIAL_ARTICLE_LIMIT=5
