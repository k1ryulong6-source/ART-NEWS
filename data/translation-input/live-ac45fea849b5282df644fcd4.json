    {
      "type": "heading",
      "text": "3lb tub of Maldon salt"
    },
    {
      "type": "image",
      "url": "https://i.guim.co.uk/img/media/fad969bead75f6c8921b79529616d3820cb79429/0_0_2500_2500/1000.jpg?width=328&dpr=1&s=none&crop=none",
      "alt": "",
