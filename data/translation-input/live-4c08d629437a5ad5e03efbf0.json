    {
      "type": "heading",
      "text": "Wildwood"
    },
    {
      "type": "paragraph",
      "text": "A forest inhabited by magical beings is the setting for this epic stop-motion saga from LAIKA Studios."
    },
    {
      "type": "image",
      "url": "https://d3cyv0xf0ss37v.cloudfront.net/2026/films/560x315/my-friend-the-sun-01.jpeg",
