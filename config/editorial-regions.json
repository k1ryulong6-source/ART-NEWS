  "collection": {
    "discovery_share": 0.2,
    "baseline_refresh_hours": 2,
    "all_enabled_feeds_each_run": true,
    "never_drop_by_region": true,
    "headline_and_major_story_override": true,
    "notes": "所有启用RSS仍每轮抓取，等级只调整先后和有限正文采集预算。头条/重大消息跨地区优先；新正文剩余预算至少20%给地区/新作者发现渠道（有候选且紧急稿未占满时），来源轮转；旧稿复查份额保留。"
  },
  "limitations": [
    "地区来源分配是编辑建设目标，不代表每国都已有独立RSS。",
    "媒体出版地、报道地点、艺术家国籍不得互相推定；未知保持未知。",
    "任何未单列国家地区均适用全球发现，不因地区等级拒收重要创作者或新闻。",
    "保留日本以外普通展览较低推荐/翻译优先级规则，重大新闻不受地区限制。"
  ],
  "media_weights": {
    "scale": [
      0,
      100
    ],
    "basis": "人工编辑初始值，不是经测量的全球读者份额、国家艺术价值或新闻真实性分数。按采集稳定性、原创采访和覆盖缺口复核调整。",
    "fields": {
      "international": "跨地区新闻的编辑影响/关联价值",
      "local_specialist": "对其明确关注地区/领域的专业报道价值",
      "discovery": "发现较少被报道的创作者与独家项目的价值"
    },
    "global_lane_share": 0.3,
    "notes": "先分来源编辑关注地区，再在地区内部按媒体权重轮转。global_core的跨地区渠道独立保留，媒体总部不等于报道地点；地区薄弱的本地媒体不会使该地区艺术家被忽略。",
    "international_gateway_threshold": 85
  }
