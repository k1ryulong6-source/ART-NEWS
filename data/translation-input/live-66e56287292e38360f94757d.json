      ]
    },
    {
      "type": "heading",
      "text": "Our programmers recommend..."
    },
    {
      "type": "image",
      "url": "https://d3cyv0xf0ss37v.cloudfront.net/2026/films/560x315/wild-horse-nine-01.jpeg",
