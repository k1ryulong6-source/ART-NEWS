      "url": "https://cdn.prod.tabdev.net/asset_files/transferred/images.ctfassets.net/j05yk38inose/2L15pmAIFRlOiGca17tJfD/21fe56f7f08897d5ea90efb5a1325959/2026-komai-tetsuro-tmb.jpg?w=579&q=70&fm=webp",
      "alt": "",
