    {
      "type": "heading",
      "text": "Iron Boy"
    },
    {
      "type": "paragraph",
      "text": "With its smooth, hand-painted style, Iron Boy is a warm, moving animation about an 11-year-old boy who is forced to rethink his outlook on the world when he receives a life-changing diagnosis."
    },
    {
      "type": "image",
      "url": "https://d3cyv0xf0ss37v.cloudfront.net/2026/films/560x315/my-friend-the-sun-01.jpeg",
      "alt": "",
      "caption": "",
      "credit": "BFI London Film Festival 2026"
    },
    {
      "type": "heading",
      "text": "My Friend the Sun"
    },
    {
      "type": "paragraph",
      "text": "In this engrossing and brightly coloured animated triumph, a young girl is transported to the home of the Mexican gods and has to fight to find her way back home."
    },
    {
      "type": "image",
      "url": "https://d3cyv0xf0ss37v.cloudfront.net/2026/films/560x315/mermaid-parade-01.jpeg",
      "alt": "",
      "caption": "",
      "credit": "BFI London Film Festival 2026"
    },
    {
      "type": "heading",
      "text": "The Mermaid Parade"
    },
    {
      "type": "paragraph",
      "text": "This magical crafting adventure is inspired by the captivating film Julián."
    }
